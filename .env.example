# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# This file lists variable NAMES and safe local-dev placeholders only — no real secret
# belongs here, because this file IS committed.
#
# Every knob below is optional except the ones marked REQUIRED. Defaults for the
# optional ones live in src/config/platform.yaml and src/config/product.yaml, which
# is where you should change a value permanently. Use env vars to override per
# environment (your machine, CI, production).

# ---------------------------------------------------------------------------
# REQUIRED — the app refuses to start without these
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public origin the app is served from. Used for cookies and CORS.
APP_ORIGIN=http://localhost:3000

# Postgres connection string. This value matches docker-compose.yml, so
# `make db-up` then `make dev` works with no edits.
DATABASE_URL=postgresql://tracker:tracker_local_dev@localhost:5432/subscription_tracker

# Signing secret for session cookies. Minimum 32 characters.
# GENERATE YOUR OWN — do not ship this placeholder:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters-abcd

# ---------------------------------------------------------------------------
# OPTIONAL — error reporting (defaults to "noop" until M3)
# ---------------------------------------------------------------------------

# noop | sentry.  If set to "sentry", SENTRY_DSN becomes required.
# ERROR_REPORTER=noop
# SENTRY_DSN=
# ERROR_REPORTER_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# OPTIONAL — overrides for src/config/platform.yaml (engine knobs)
# ---------------------------------------------------------------------------

# LOG_LEVEL=info          # trace|debug|info|warn|error|fatal
# LOG_PRETTY=true         # human-readable logs in dev; leave false in production

# DB_POOL_MAX=10
# DB_CONNECT_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_CONNECT_RETRIES=2
# DB_CONNECT_RETRY_BACKOFF_MS=250

# SESSION_TTL_DAYS=30
# SESSION_REFRESH_EVERY_DAYS=1

# RATE_LIMIT_ENABLED=false   # switched on at M3
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_SIGNUP_MAX=5
# RATE_LIMIT_LOGIN_MAX=10

# ---------------------------------------------------------------------------
# OPTIONAL — overrides for src/config/product.yaml (product knobs)
# ---------------------------------------------------------------------------

# RENEWALS_UPCOMING_WINDOW_DAYS=30
# DEFAULT_CURRENCY=USD
# MAX_SUBSCRIPTIONS_PER_ACCOUNT=500
# MAX_SUBSCRIPTION_NAME_LENGTH=100
# MAX_PRICE_MAJOR_UNITS=1000000
