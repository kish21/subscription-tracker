# --- Secrets: never commit anything but .env.example ---
.env
.env.*
!.env.example
*.env
*.env.local
.env.bak
.env.backup
.env.*.bak
secrets/
*.pem
*.key
*.p12
*.pfx

# --- Dependencies ---
node_modules/
.pnpm-store/

# --- Build output ---
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# --- Test + coverage artifacts ---
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/
.playwright/

# --- Tooling caches ---
.cache/
.turbo/
.eslintcache

# --- Local database volumes ---
.postgres-data/

# --- Logs ---
*.log
npm-debug.log*
pnpm-debug.log*
logs/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# --- lanekeeper (managed) ---
# Runtime state, logs and agent worktrees are machine-local and must never be committed.
# Without these rules an agent running `git add -A` would sweep every other agent's
# worktree into its own commit.
/.lanekeeper/*
# The lane policy and the seat cards are the team's shared contract - keep them tracked.
!/.lanekeeper/config.yaml
!/.lanekeeper/capabilities/
# --- end lanekeeper ---
